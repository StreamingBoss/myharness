{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "typescript",
    "outDir": "dist/typescript"
  },
  "include": ["typescript/**/*.ts"]
}
